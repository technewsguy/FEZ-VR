<?xml version="1.0" encoding="utf-8"?>
<!-- FEZ-VR: loads the VR mod (FEZ-VR.exe, class FezVr.Boot) into FEZ.exe when it starts. FEZ doesn't ship this file.
     Delete it (or run "FEZ-VR Uninstall.exe") to play FEZ without the mod. -->
<configuration>
  <runtime>
    <appDomainManagerAssembly value="FEZ-VR, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="FezVr.Boot" />
  </runtime>
</configuration>
